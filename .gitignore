# Python 編譯檔與快取 (Byte-compiled / optimized files)
__pycache__/
*.py[cod]
*$py.class

# 虛擬環境目錄 - 避免上傳數百 MB 的套件 (Virtual environments)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook 暫存檔與檢查點 (Jupyter Notebook checkpoints)
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# 環境變數與 API 密鑰 - 絕對不可上傳 (Environment variables & API credentials)
.env
.env.*
!.env.example

# 作業系統暫存檔 (OS-specific temporary files)
.DS_Store
Thumbs.db

# 開發環境設定檔 (IDE workspace settings)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# 原始 PDF 與批次處理輸出不納入版控，保留資料夾結構
data/raw/**/*.pdf
data/interim/**/*.md
data/processed/**/*.json

# 保留空資料夾所需的 .keep 檔案
!data/raw/**/.keep
!data/interim/**/.keep
!data/processed/**/.keep

# 大型二進位檔、壓縮檔與模型權重 (Large binary files, archives & model weights)
*.bin
*.pt
*.pth
*.onnx
*.tar.gz
*.zip
*.parquet
*.sqlite3
*.db
